{
	"$schema": "../printer-definition.schema.json",
	"name": "Tic Tac 2.1",
	"description": "A V-Minion style printer with a 120mm3 build volume",
	"manufacturer": "Squirrelbrain",
	"documentationLink": "https://os.ratrig.com/docs/printers/tic-tac-21",
	"image": "tic-tac.png",
	"template": "tic-tac-21-printer.template.cfg",
	"driverCountRequired": 4,
	"sizes": {
		"120": {
			"x": 120,
			"y": 120,
			"z": 120
		}
	},
	"kinematics": "cartesian",
	"speedLimits": {
		"basic": {
			"accel": 3000,
			"velocity": 200,
			"z_accel": 200,
			"z_velocity": 15,
			"travel_accel": 3000,
			"travel_velocity": 200
		},
		"performance": {
			"accel": 15000,
			"velocity": 600,
			"z_accel": 600,
			"z_velocity": 15,
			"travel_accel": 8000,
			"travel_velocity": 600
		}
	},
	"bedMargin": {
		"x": [17, 0],
		"y": [5, 5]
	},
	"defaults": {
		"board": "btt-skr-pico",
		"toolheads": [
			{
				"axis": "x",
				"extruder": "orbiter-2",
				"hotend": "rapido-plus-uhf",
				"partFan": "2pin",
				"hotendFan": "2pin",
				"probe": "probe",
				"xEndstop": "sensorless",
				"yEndstop": "sensorless"
			}
		],
		"rails": [
			{
				"axis": "x",
				"axisDescription": "The X axis motor moves the print head left and right.",
				"current": 0.8,
				"performanceMode": {
					"current": 1.188,
					"homingSpeed": 100
				},
				"driver": "BTT-TMC2209-13",
				"stepper": "LDO-42STH40-1684AC",
				"homingSpeed": 50,
				"rotationDistance": 40
			},
			{
				"axis": "y",
				"axisDescription": "The Y axis motor moves the print bed forward and backward.",
				"current": 0.8,
				"performanceMode": {
					"current": 1.188,
					"homingSpeed": 100
				},
				"driver": "BTT-TMC2209-13",
				"stepper": "LDO-42STH40-1684AC",
				"homingSpeed": 50,
				"rotationDistance": 40
			},
			{
				"axis": "z",
				"axisDescription": "The Z axis motor moves the print head up and down.",
				"current": 0.8,
				"performanceMode": {
					"current": 1.188
				},
				"driver": "BTT-TMC2209-13",
				"stepper": "LDO-42STH40-1684AC",
				"rotationDistance": 40,
				"gearRatio": "80:16"
			},
			{
				"axis": "extruder",
				"axisDescription": "The extruder motor used for your toolhead",
				"current": 0.707,
				"driver": "BTT-TMC2209-13",
				"stepper": "LDO-36STH20-1004AHG",
				"rotationDistance": 0
			}
		],
		"controllerFan": "2pin"
	}
}
